# Copy this file to .env and paste your key(s). One key is enough; two gives you a backup.
# OpenAI (primary, needs prepaid credit): https://platform.openai.com/api-keys
OPENAI_API_KEY=paste-your-openai-key-here

# Gemini (backup, free tier): https://aistudio.google.com
GEMINI_API_KEY=paste-your-gemini-key-here

# Optional settings
# WORKSHOP_PROVIDER=auto
# OPENAI_MODELS=gpt-6-luna,gpt-5-mini,gpt-4o-mini
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# OLLAMA_MODEL=llama3.2
